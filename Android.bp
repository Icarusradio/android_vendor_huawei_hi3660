soong_namespace {
}

android_app_import {
	name: "gnss_supl20service_hisi",
	owner: "huawei",
	apk: "system/priv-app/gnss_supl20service_hisi/gnss_supl20service_hisi.apk",
	certificate: "platform",
	dex_preopt: {
		enabled: false,
	},
	privileged: true,
}

android_app_import {
	name: "Camera",
	owner: "huawei",
	apk: "system/app/Camera/Camera.apk",
	certificate: "platform",
	dex_preopt: {
		enabled: false,
	},
	product_specific: true,
	overrides: [
		"Aperture",
		"Camera2"
	],
}

// The stock HWC requires VNDK 28 libui, no longer shipped in Android 15.
cc_prebuilt_library_shared {
    name: "libui-v28",
    owner: "huawei",
    soc_specific: true,
    compile_multilib: "both",
    target: {
        android_arm: {
            srcs: ["vndk/v28/arm/libui-v28.so"],
        },
        android_arm64: {
            srcs: ["vndk/v28/arm64/libui-v28.so"],
        },
    },
    strip: { none: true },
    check_elf_files: false,
    stl: "none",
    system_shared_libs: [],
}

